# .github/app-config.env — the ONLY per-app file in the TestFlight lane.
#
# Copy this to .github/app-config.env and fill it in. Everything else in the
# template (the workflow and the scripts under .github/scripts/) is identical in
# every repo and should be copied verbatim.
#
# The workflow `source`s this file with `set -a`, so it is shell syntax:
#   - no spaces around `=`
#   - QUOTE any value containing a space (profile names usually do)
#   - `#` starts a comment
#   - nothing here is secret. Every credential comes from org-level secrets
#     (APPLE_TEAM_ID, APP_STORE_CONNECT_ISSUER_ID, APP_STORE_CONNECT_KEY_ID,
#     APP_STORE_CONNECT_P8_BASE64, DIST_CERT_P12_BASE64, DIST_CERT_PASSWORD,
#     KEYCHAIN_PASSWORD) which every repo in the org inherits automatically.
#     Do not add a secret to this file; it is committed.


# ---------------------------------------------------------------- required ---

# The app's bundle identifier, exactly as it appears in Certificates,
# Identifiers & Profiles. It must ALREADY EXIST there — this lane will not
# create it (see README.md, "Apple-side setup").
APP_BUNDLE_ID=com.example.myapp

# Path from the repo root to the directory holding the Xcode project — the one
# with Runner.xcodeproj / MyApp.xcodeproj and the Podfile in it.
#   native iOS repo:   ios
#   Flutter monorepo:  apps/mobile/ios
# The Flutter project root is derived as the parent of this directory, so
# `apps/mobile/ios` implies the flutter commands run in `apps/mobile`.
IOS_DIR=ios

# 1 for a Flutter app (built with `flutter build ipa --release -v`),
# 0 for a native iOS app (built with `xcodebuild archive` + `-exportArchive`).
FLUTTER=0

# 1 if the app ships an app extension that needs its own provisioning profile
# (a Call Directory extension, a share extension, a widget, ...). 0 otherwise.
# When 0, every extension-specific setting below is ignored, the extension
# checks do not run, and only the app's own profile is minted.
HAS_EXTENSION=0


# ---------------------------------------------------------------- optional ---

# The name the app's provisioning profile is minted under, and reused by on
# every later run. It is NOT a secret and NOT a lookup of something Apple
# already has — this lane creates it. Two consequences worth understanding:
#
#   1. Because it is deterministic and public, you can (and should) hardcode it
#      as PROVISIONING_PROFILE_SPECIFIER in the app target's build settings.
#      The lane this came from could not do that: its profile name arrived as a
#      secret.
#   2. Changing it after the first successful run mints a SECOND profile in the
#      Apple account rather than renaming the first. Pick it once.
#
# Defaults to "<APP_BUNDLE_ID> App Store" if left unset. Setting it explicitly
# is recommended so the value in Xcode and the value here cannot drift.
#APP_PROFILE_NAME="My App App Store"

# The profile type to mint and to accept on reuse. Effectively always
# IOS_APP_STORE for a TestFlight lane; the knob exists so a profile of the right
# name but the WRONG TYPE (an IOS_APP_DEVELOPMENT one, say) is refused loudly
# here rather than failing obscurely at codesign.
#PROFILE_TYPE=IOS_APP_STORE

# The scheme to archive. REQUIRED when FLUTTER=0, ignored when FLUTTER=1.
#SCHEME=MyApp

# A command run before anything else in the Dependencies step -- from the
# repository root, through `bash -lc`. This exists for projects whose .xcodeproj
# is GENERATED and therefore not in git: xcodegen, tuist, or a project-specific
# script. Without it the archive step fails on a container that was never
# created, which is what happened the first time this lane was adopted into a
# real project.
#
# Whatever it runs must produce the container named by XCODE_PROJECT or
# XCODE_WORKSPACE below. preflight.py checks that the container exists, so a
# missing PREBUILD is caught locally in milliseconds rather than twelve minutes
# into a build.
#PREBUILD=bash scripts/ios-xcodegen.sh

# Which container xcodebuild opens. Only one of these, and only when FLUTTER=0.
# If neither is set the lane looks for exactly one *.xcworkspace in IOS_DIR and
# falls back to exactly one *.xcodeproj. Set one explicitly if that is ambiguous.
#XCODE_WORKSPACE=MyApp.xcworkspace
#XCODE_PROJECT=MyApp.xcodeproj

# Extra arguments appended to the `xcodebuild archive` command line
# (FLUTTER=0 only). Shell-quoted: CODE_SIGN_IDENTITY="Apple Distribution"
# survives as one argument.
#
# READ THE WARNING IN README.md BEFORE PUTTING A
# PROVISIONING_PROFILE_SPECIFIER HERE: a specifier on the command line is
# GLOBAL, it is applied to CocoaPods dependency targets that "do not support
# provisioning profiles", and the archive fails. Per-target signing belongs in
# the project file.
#XCODEBUILD_EXTRA=

# Flutter version for subosito/flutter-action (FLUTTER=1 only). If unset, the
# lane reads `flutter = "x.y.z"` out of .mise.toml at the repo root, and if
# there is no such line it takes the latest stable.
#FLUTTER_VERSION=3.24.0

# Name of the throwaway keychain created for this build and deleted in the
# always() cleanup. Defaults to `ci-<run id>.keychain`, which cannot collide
# with another job on the same self-hosted Mac or with anything of the owner's.
# Override only if you have a reason to.
#KEYCHAIN_NAME=my-app-ci.keychain


# ------------------------------------------------- only when HAS_EXTENSION=1 ---

# The extension's bundle identifier. Like APP_BUNDLE_ID it must already exist in
# Certificates, Identifiers & Profiles, with the App Groups capability enabled
# on it if APP_GROUP is set below.
#EXTENSION_BUNDLE_ID=com.example.myapp.calldirectory

# The name the extension's profile is minted under and reused by. Same
# stability rule as APP_PROFILE_NAME: changing it mints a second profile.
#EXTENSION_PROFILE_NAME="My App Call Directory App Store"

# The App Group the app and its extension share, e.g. group.com.example.myapp.
#
# WHEN SET, IT IS ENFORCED ON BOTH PROFILES. An existing profile of the right
# name, state and type whose entitlements do NOT grant this group is refused,
# not reused — profiles capture entitlements AT CREATION, so one minted before
# the group was attached to the bundle id stays broken forever while continuing
# to look perfect in the portal. Reusing it reproduces the original CodeSign
# failure exactly, which reads as "the fix did not work" rather than as "you are
# holding a stale profile".
#
# Leave EMPTY if the app and extension do not share a group. An empty value
# disables the entitlement check entirely; it does not mean "any group".
#APP_GROUP=group.com.example.myapp

# Path from the repo root to the extension's Info.plist. When set (and
# HAS_EXTENSION=1) the lane asserts the extension point Apple actually accepts,
# on the runner, before the archive. Leave unset to skip that check.
#EXTENSION_INFO_PLIST=ios/MyAppCallDirectory/Info.plist

# The NSExtensionPointIdentifier the plist above must declare. REQUIRED if
# EXTENSION_INFO_PLIST is set.
#
# For a Call Directory extension the correct value is
#   com.apple.callkit.call-directory
# and NOT com.apple.identitylookup.call-directory. The identitylookup family is
# real — it holds message-filter and classification-ui — which is exactly why
# the wrong value survives review: it is well formed and names a namespace that
# exists. Apple rejects it at UPLOAD with error 90349, after the runner launch,
# the signing and the archive. Nothing in a local build has an opinion about it.
#EXTENSION_POINT_ID=com.apple.callkit.call-directory

# Optional. If set, NSExtensionPrincipalClass must end with this string, so a
# renamed handler class is caught here rather than by an appex that installs and
# silently never runs.
#EXTENSION_PRINCIPAL_CLASS_SUFFIX=.CallDirectoryHandler
